
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=wiki.raw.edits

WIKIMEDIA_STREAM_URL=https://stream.wikimedia.org/v2/stream/recentchange

# Replace with a real contact email before running.
WIKIMEDIA_USER_AGENT=WikiPulse/0.1 (contact: your-email@example.com)

LOG_LEVEL=INFO
STATS_INTERVAL_SECONDS=30



# Spark
SPARK_MASTER=local[2]
SPARK_KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.6

# Raw storage
RAW_PARQUET_PATH=data/raw/wikipedia_edits
RAW_CHECKPOINT_PATH=data/checkpoints/raw_edits

# Streaming
SPARK_TRIGGER_SECONDS=10


# Maximum Kafka records per Bronze microbatch (Week 2)
SPARK_MAX_OFFSETS=50000
